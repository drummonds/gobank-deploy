# One question: what does the orchestrator talk to at run time, from
# either place it runs? How a version gets here is release-path.d2; what
# an up does in order is deploy-sequence.d2.

direction: down

classes: {
  place: {style.border-radius: 8; style.font-size: 15}
  part: {shape: rectangle; style.border-radius: 6}
}

operators: "gobank-deploy runs in two places" {
  class: place
  laptop: "Laptop\nCLI and page; builds from the checkout" {class: part}
  hydrogen: "hydrogen (gokrazy, LAN)\npage behind gokcaddy; deploys from its store" {class: part}
}

bitwarden: "Bitwarden\nHCLOUD_TOKEN · ssh key · AWS keys" {class: part}

hetzner: "Hetzner Cloud project" {
  class: place
  server: "gobank-<env>: Ubuntu, PostgreSQL, demo :1347\nfirewall 22 · 1347 · icmp\nlabels environment, expires" {class: part}
}

route53: "AWS Route 53 — drummonds.net" {
  class: place
  record: "<env>.gobank.drummonds.net → server IP\nA, TTL 60" {class: part}
}

bitwarden -> operators.laptop: tp secrets
bitwarden -> operators.hydrogen: gokrazy Environment
operators.laptop -> hetzner.server: hcloud API · ssh
operators.hydrogen -> hetzner.server: hcloud API · ssh
operators.laptop -> route53.record: up · down
operators.hydrogen -> route53.record: up · down
